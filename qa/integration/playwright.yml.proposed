
name: Playwright Regression Tests

on:
  push:
    branches: [qa-playwright]
  pull_request:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  test:
    name: Chromium Tests
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '22'

      - name: Install dependencies
        run: npm ci --no-audit --no-fund

      - name: Install Chromium
        run: npx playwright install --with-deps chromium

      - name: Run Playwright tests
        run: npm test

      - name: Run QA Framework v1
        run: npm run qa:v1

      - name: Upload test report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: playwright-report
          path: |
            playwright-report/
            test-results/
            qa/reports/QA_Report.html
            qa/reports/results.json
            qa/reports/source-audit.json
            qa/reports/release-gate.json
            qa/reports/mutations.json
            qa/reports/Coverage_Matrix.csv
            qa/reports/target-environment.json
            qa/reports/pipeline.json
          retention-days: 14
          if-no-files-found: ignore

