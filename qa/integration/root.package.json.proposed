{
  "name": "fraud-aml-legal-template-studio-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Automated regression tests for the legal template studio",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke.spec.js",
    "test:report": "playwright show-report",
    "qa:v1": "node qa/scripts/qa.js index.html",
    "qa:v1:tests": "node qa/scripts/run-tests.js",
    "qa:v1:report": "node qa/scripts/report.js"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "http-server": "14.1.1",
    "parse5": "7.2.1",
    "diff": "8.0.2",
    "tailwindcss": "3.4.17"
  }
}
